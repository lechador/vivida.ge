imentEvents = pgTable(\\n51|  \\\"experiment_event\\\",\\n52|  {\\n53|    id: text(\\\"id\\\")\\n54|      .primaryKey()\\n55|      .$defaultFn(() => crypto.randomUUID()),\\n56|    userId: text(\\\"user_id\\\")\\n57|      .notNull()\\n58|      .references(() => users.id, { onDelete: \\\"cascade\\\" }),\\n59|    experiment: text(\\\"experiment\\\").notNull(),\\n60|    variant: text(\\\"variant\\\").notNull(),\\n61|    /** exposure | outcome */\\n62|    eventType: text(\\\"event_type\\\").notNull(),\\n63|    eventName: text(\\\"event_name\\\").notNull(),\\n64|    surface: text(\\\"surface\\\").notNull(),\\n65|    eventKey: text(\\\"event_key\\\").notNull(),\\n66|    createdAt: timestamp(\\\"created_at\\\", { withTimezone: true })\\n67|      .defaultNow()\\n68|      .notNull(),\\n69|  },\\n70|  (t) => [\\n71|    uniqueIndex(\\\"experiment_event_dedupe_idx\\\").on(\\n72|      t.userId,\\n73|      t.experiment,\\n74|      t.eventType,\\n75|      t.eventName,\\n76|      t.eventKey,\\n77|    ),\\n78|    index(\\\"experiment_event_analysis_idx\\\").on(\\n79|      t.experiment,\\n80|      t.variant,\\n81|      t.eventType,\\n82|      t.createdAt,\\n83|    ),\\n84|  ],\\n85|);\\n86|\\n87|export type ExperimentEvent = typeof experimentEvents.$inferSelect;\\n88|\\n89|/**\\n90| * Stripe-backed Premium entitlement. One current subscription per user keeps\\n91| * the app-side access check cheap while Stripe remains the billing authority.\\n92| */\\n93|/**\\n94| * Who is billing this subscription. Stripe is the website's processor; the\\n95| * store builds cannot use it (Apple 3.1.1 / Play Billing), so an app purchase\\n96| * arrives through RevenueCat instead. One user still has at most one PRO row —\\n97| * `source` says which processor owns it, and a webhook may only deactivate a\\n98| * row whose source matches, so neither can cancel the other's subscription.\\n99| */\\n100|export type PremiumSource = \\\"stripe\\\" | \\\"revenuecat\\\";\", \"total_lines\": 100, \"file_size\": 3