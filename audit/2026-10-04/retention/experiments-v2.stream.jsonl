{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|import {\\n2|  pgTable,\\n3|  text,\\n4|  timestamp,\\n5|  integer,\\n6|  jsonb,\\n7|  boolean,\\n8|  index,\\n9|  pgEnum,\\n10|} from \\\"drizzle-orm/pg-core\\\";\\n11|import type { PremiumSource } from \\\"./experiments\\\";\\n12|import { users } from \\\"./users\\\";\\n13|\\n14|/**\\n15| * Credit wallet — one row per user, atomically updated. Balance is authoritative\\n16| * and always kept in sync with the ledger (credit_transaction). We spend with a\\n17| * single conditional UPDATE (`balance >= cost`) so two concurrent requests can\\n18| * never overspend.\\n19| */\\n20|export const creditAccounts = pgTable(\\\"credit_account\\\", {\\n21|  userId: text(\\\"user_id\\\")\\n22|    .primaryKey()\\n23|    .references(() => users.id, { onDelete: \\\"cascade\\\" }),\\n24|  balance: integer(\\\"balance\\\").notNull().default(0),\\n25|  updatedAt: timestamp(\\\"updated_at\\\", { withTimezone: true })\\n26|    .defaultNow()\\n27|    .notNull(),\\n28|});\\n29|\\n30|/**\\n31| * Append-only credit ledger — every grant (+) and spend (−) with a reason, for\\n32| * audit + the account history. `ref` links to the source (referral's invited\\n33| * user id, stripe session id, the synastry/partner id spent on, …).\\n34| */\\n35|export const creditTransactions = pgTable(\\n36|  \\\"credit_transaction\\\",\\n37|  {\\n38|    id: text(\\\"id\\\")\\n39|      .primaryKey()\\n40|      .$defaultFn(() => crypto.randomUUID()),\\n41|    userId: text(\\\"user_id\\\")\\n42|      .notNull()\\n43|      .references(() => users.id, { onDelete: \\\"cascade\\\" }),\\n44|    /** Signed: positive = earned/bought, negative = spent. */\\n45|    amount: integer(\\\"amount\\\").notNull(),\\n46|    /** e.g. 'signup_bonus' | 'referral' | 'purchase' | 'spend_synastry' |\\n47|     *  'spend_chat' | 'grandfather' | 'admin_grant'. */\\n48|    reason: text(\\\"reason\\\").notNull(),\\n49|    ref: text(\\\"ref\\\"),\\n50|    createdAt: ti