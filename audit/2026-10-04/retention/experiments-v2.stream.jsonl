{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|import \\\"server-only\\\";\\n2|\\n3|import { sql } from \\\"drizzle-orm\\\";\\n4|\\n5|import { db } from \\\"@/db\\\";\\n6|import {\\n7|  creditGuardrail,\\n8|  freeCreditRatio,\\n9|  type CreditGuardrail,\\n10|} from \\\"@/lib/credit-economy-metrics\\\";\\n11|\\n12|export type ExperimentMetricRow = {\\n13|  experiment: string;\\n14|  variant: string;\\n15|  assigned: number;\\n16|  exposed: number;\\n17|  checkoutStarted: number;\\n18|  purchaseCompleted: number;\\n19|};\\n20|\\n21|export type ReminderFunnelRow = {\\n22|  topic: string;\\n23|  optedIn: number;\\n24|  delivered: number;\\n25|  valueCompleted: number;\\n26|  optedOut: number;\\n27|};\\n28|\\n29|export type CreditWeekRow = {\\n30|  weekStart: string;\\n31|  freeIssued: number;\\n32|  purchased: number;\\n33|  spent: number;\\n34|  ratio: number | null;\\n35|  guardrail: CreditGuardrail;\\n36|};\\n37|\\n38|export type RelationshipMetrics = {\\n39|  invitesCreated: number;\\n40|  invitesAccepted: number;\\n41|  weeklySubscribers: number;\\n42|  transitSubscribers: number;\\n43|  answers: number;\\n44|  answerUsers: number;\\n45|  weeklyUpdates: number;\\n46|};\\n47|\\n48|export type FirstPurchaseMetrics = {\\n49|  total: number;\\n50|  credits: number;\\n51|  premium: number;\\n52|  newRegistrations: number;\\n53|  returningUsers: number;\\n54|  valueDelivered24h: number;\\n55|};\\n56|\\n57|function numberValue(value: unknown): number {\\n58|  const number = Number(value ?? 0);\\n59|  return Number.isFinite(number) ? number : 0;\\n60|}\\n61|\\n62|export async function getGrowthMetrics(days: 28 | 84): Promise<{\\n63|  experiments: ExperimentMetricRow[];\\n64|  reminders: ReminderFunnelRow[];\\n65|  creditWeeks: CreditWeekRow[];\\n66|  creditSummary: { freeIssued: number; purchased: number; spent: number };\\n67|  relationships: RelationshipMetrics;\\n68|  firstPurchases: FirstPurchaseMetrics;\\n69|}> {\\n70|  const interval = `${days} days`;\\n71|  const [experimentResult, preferenceResult, deliveryResult, creditResult, creditSummaryResult, relationshipResult, firstPurchaseResult] = await Promise.all([\\n72|    db.execute(sql`\\n73|      SELECT\\n74|        a.experiment,\\n75|        a.variant,\\n76|        count(DISTINCT a.user_id) FILTER (\\n77|          WHERE a.assigned_at >= now() - ${interval}::interval\\n78|        )::int AS assigned,\\n79|        count(DISTINCT e.user_id) FILTER (\\n80|          WHERE e.event_type = 'exposure'\\n81|        )::int AS exposed,\\n82|        count(DISTINCT e.event_key) FILTER (\\n83|          WHERE e.event_type = 'outcome' AND e.event_name = 'checkout_started'\\n84|        )::int AS checkout_started,\\n85|        count(DISTINCT e.event_key) FILTER (\\n86|          WHERE e.event_type = 'outcome' AND e.event_name = 'purchase_completed'\\n87|        )::int AS purchase_completed\\n88|      FROM experiment_assignment a\\n89|      LEFT JOIN experiment_event e\\n90|        ON e.user_id = a.user_id\\n91|       AND e.experiment = a.experiment\\n92|       AND e.created_at >= now() - ${interval}::interval\\n93|      WHERE a.experiment IN (\\n94|        'pricing_presentation_v1',\\n95|        'contextual_paywall_v1',\\n96|        'reminder_prompt_v1'\\n97|      )\\n98|      GROUP BY a.experiment, a.variant\\n99|      ORDER BY a.experiment, a.variant\\n100|    `),\\n101|    db.execute(sql`\\n102|      SELECT\\n103|        topic,\\n104|        count(DISTINCT user_id) FILTER (WHERE event_type = 'opt_in')::int AS opted_in,\\n105|        count(DISTINCT user_id) FILTER (WHERE event_type = 'opt_out')::int AS opted_out\\n106|      FROM reminder_preference_event\\n107|      WHERE created_at >= now() - ${interval}::interval\\n108|      GROUP BY topic\\n109|    `),\\n110|    db.execute(sql`\\n111|      SELECT\\n112|        topic,\\n113|        count(DISTINCT (user_id, delivery_key)) FILTER (WHERE status = 'sent')::int AS delivered,\\n114|        count(DISTINCT (user_id, delivery_key)) FILTER (\\n115|          WHERE status = 'sent' AND value_completed_at IS NOT NULL\\n116|        )::int AS value_completed\\n117|      FROM reminder_delivery\\n118|      WHERE created_at >= now() - ${interval}::interval\\n119|      GROUP BY topic\\n120|    `),\\n121|    db.execute(sql`\\n122|      WITH weeks AS (\\n123|        SELECT generate_series(\\n124|          date_trunc('week', timezone('Asia/Tbilisi', now())) - interval '3 weeks',\\n125|          date_trunc('week', timezone('Asia/Tbilisi', now())),\\n126|          interval '1 week'\\n127|        ) AS week_start\\n128|      )\\n129|      SELECT\\n130|        to_char(w.week_start, 'YYYY-MM-DD') AS week_start,\\n131|        coalesce(sum(CASE WHEN t.amount > 0 AND t.reason <> 'purchase' THEN t.amount ELSE 0 END), 0)::int AS free_issued,\\n132|        coalesce(sum(CASE WHEN t.amount > 0 AND t.reason = 'purchase' THEN t.amount ELSE 0 END), 0)::int AS purchased,\\n133|        coalesce(sum(CASE WHEN t.amount < 0 THEN -t.amount ELSE 0 END), 0)::int AS spent\\n134|      FROM weeks w\\n135|      LEFT JOIN credit_transaction t\\n136|        ON timezone('Asia/Tbilisi', t.created_at) >= w.week_start\\n137|       AND timezone('Asia/Tbilisi', ...", "duration_ms": 71, "is_error": false, "timestamp": 1791096910007}
{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|/**\\n2| * Credit-economy constants — the pure, client-safe half of the credit system.\\n3| *\\n4| * Split out from lib/credits.ts (which imports the DB) so client components\\n5| * (top-up card, invite card, etc.) can read prices/rewards without pulling\\n6| * server-only code into the browser bundle. lib/credits re-exports everything\\n7| * here, so server code can keep importing from a single place.\\n8| *\\n9| * Tuning the economy is a one-line change in this file.\\n10| */\\n11|\\n12|export const SIGNUP_BONUS = 20;\\n13|/** signup_credits_v1: staged cohort receives this immediately. */\\n14|export const STAGED_SIGNUP_BONUS = 10;\\n15|/** signup_credits_v1: staged cohort receives this on its first 24h+ return. */\\n16|export const STAGED_RETURN_BONUS = 5;\\n17|export const REFERRAL_REWARD = 10;\\n18|/** Free credits granted to every user on the first day of each month. */\\n19|export const MONTHLY_BONUS = 5;\\n20|/** Phone-gift campaign: one-time reward for verifying a mobile number. */\\n21|export const PHONE_VERIFY_GIFT = 10;\\n22|/** …granted on top of the above when promotional-SMS consent first turns on. */\\n23|export const SMS_CONSENT_GIFT = 10;\\n24|\\n25|export {\\n26|  creditPackForCountry,\\n27|  creditPacksForCountry,\\n28|  featuredPremiumPlanForCountry,\\n29|  formatBillingAmount,\\n30|  premiumPlanForCountry,\\n31|  PURCHASE_PROMOTION_CREDIT_THRESHOLD,\\n32|  shouldShowPurchasePromotion,\\n33|  type CreditPack,\\n34|  type PremiumPlan,\\n35|} from \\\"@/lib/billing-config\\\";\\n36|\\n37|/** Credits EARNED by activity (beyond signup/referral/purchase). Capped to\\n38| *  prevent farming — see the caps below. */\\n39|export const CREDIT_REWARD = {\\n40|  /** One small weekly reward keeps the feed loop alive without replacing purchases. */\\n41|  feedPost: 1,\\n42|  profilePhoto: 3,\\n43|} as const;\\n44|\\n45|/** Anti-farming caps for earned credits. */\\n46|export const REWARD_CAP = {\\n47|  /** Only the first eligible feed post in a UTC week earns credits. */\\n48|  feedPostPerWeek: 1,\\n49|  /** Profile-photo reward is one-time (guarded by ledger presence). */\\n50|} as const;\\n51|\\n52|/** Lifetime-only ritual milestones. Total possible reward: 8 credits. */\\n53|export const RITUAL_STREAK_MILESTONES = [\\n54|  { days: 7, credits: 1 },\\n55|  { days: 30, credits: 2 },\\n56|  { days: 100, credits: 5 },\\n57|] as const;\\n58|\\n59|/** What each gated action costs (beyond its free allowance). */\\n60|export const CREDIT_COST = {\\n61|  synastry: 5,\\n62|  chat: 2,\\n63|  /** One AI dream interpretation. No free allowance — every reading costs. */\\n64|  dream: 2,\\n65|  mbtiTest: 5,\\n66|  iqTest: 5,\\n67|  eqTest: 5,\\n68|  bigFiveTest: 5,\\n69|  pdfReport: 5,\\n70|  weeklyForecast: 10,\\n71|  tarot: 10,\\n72|  /** A follow-up question on an already-drawn tarot spread. */\\n73|  tarotFollowup: 5,\\n74|} as const;\\n75|\\n76|/** Free before credits are needed. */\\n77|export const FREE_ALLOWANCE = {\\n78|  /** Lifetime free compatibility charts. */\\n79|  synastry: 1,\\n80|  /** Free AI-chat messages per day. */\\n81|  chatPerDay: 2,\\n82|  /** Lifetime free tarot readings before each costs credits. */\\n83|  tarot: 1,\\n84|} as const;\\n85|\\n86|export type CreditReason =\\n87|  | \\\"signup_bonus\\\"\\n88|  | \\\"first_return_bonus\\\"\\n89|  | \\\"referral\\\"\\n90|  | \\\"purchase\\\"\\n91|  | \\\"monthly_bonus\\\"\\n92|  | \\\"streak_bonus\\\"\\n93|  | \\\"birthday_gift\\\"\\n94|  | \\\"campaign_reward\\\"\\n95|  | \\\"earn_feed_post\\\"\\n96|  | \\\"earn_profile_photo\\\"\\n97|  | \\\"earn_phone_verify\\\"\\n98|  | \\\"earn_sms_consent\\\"\\n99|  | \\\"spend_synastry\\\"\\n100|  | \\\"spend_chat\\\"\\n101|  | \\\"spend_dream\\\"\\n102|  | \\\"spend_mbti\\\"\\n103|  | \\\"spend_iq\\\"\\n104|  | \\\"spend_eq\\\"\\n105|  | \\\"spend_bigfive\\\"\\n106|  | \\\"spend_audio\\\"\\n107|  | \\\"spend_report\\\"\\n108|  | \\\"spend_weekly\\\"\\n109|  | \\\"spend_tarot\\\"\\n110|  | \\\"spend_tarot_followup\\\"\\n111|  | \\\"grandfather\\\"\\n112|  | \\\"admin_grant\\\";\\n113|\\n114|/**\\n115| * Short Georgian label per reason — used in the credit notification row so the\\n116| * user sees *why* their balance moved. Kept here (client-safe) so the\\n117| * notifications dropdown can read it without pulling in server code.\\n118| */\\n119|export const CREDIT_REASON_LABEL_KA: Record<CreditReason, string> = {\\n120|  signup_bonus: \\\"მისალმების ბონუსი\\\",\\n121|  first_return_bonus: \\\"დაბრუნების ბონუსი\\\",\\n122|  referral: \\\"მეგობრის მოწვევა\\\",\\n123|  purchase: \\\"ბალანსის შევსება\\\",\\n124|  monthly_bonus: \\\"თვის ბონუსი\\\",\\n125|  streak_bonus: \\\"დღიური სერიის ბონუსი\\\",\\n126|  birthday_gift: \\\"დაბადების დღის საჩუქარი\\\",\\n127|  campaign_reward: \\\"დაბადების დეტალების შევსების ბონუსი\\\",\\n128|  earn_feed_post: \\\"პოსტი ფიდში\\\",\\n129|  earn_profile_photo: \\\"პროფილის ფოტო\\\",\\n130|  earn_phone_verify: \\\"ნომრის დადასტურება\\\",\\n131|  earn_sms_consent: \\\"მარკეტინგული SMS\\\",\\n132|  spend_synastry: \\\"თავსებადობა\\\",\\n133|  spend_chat: \\\"AI ჩატი\\\",\\n134|  spend_dream: \\\"სიზმრის AI ახსნა\\\",\\n135|  spend_mbti: \\\"პიროვნების ტესტი\\\",\\n136|  spend_iq: \\\"IQ ტესტი\\\",\\n137|  spend_eq: \\\"EQ ტესტი\\\",\\n138|  spend_bigfive: \\\"Big Five ტე...", "duration_ms": 73, "is_error": false, "timestamp": 1791096910008}
