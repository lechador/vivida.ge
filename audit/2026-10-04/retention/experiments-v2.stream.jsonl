{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|import { and, eq, isNull } from \\\"drizzle-orm\\\";\\n2|\\n3|import { db } from \\\"@/db\\\";\\n4|import { experimentAssignments } from \\\"@/db/schema\\\";\\n5|import {\\n6|  grantCreditsOnce,\\n7|  SIGNUP_BONUS,\\n8|} from \\\"@/lib/credits\\\";\\n9|import {\\n10|  initialSignupCredits,\\n11|  isSignupCreditVariant,\\n12|  qualifiesForStagedReturn,\\n13|  SIGNUP_CREDITS_ELIGIBILITY,\\n14|  SIGNUP_CREDITS_EXPERIMENT,\\n15|  SIGNUP_CREDITS_STAGED_RETURN_AMOUNT,\\n16|  signupCreditVariantFor,\\n17|  type PendingSignupCreditAssignment,\\n18|  type SignupCreditVariant,\\n19|} from \\\"@/lib/signup-credit-experiment-config\\\";\\n20|\\n21|export {\\n22|  SIGNUP_CREDITS_EXPERIMENT,\\n23|  type PendingSignupCreditAssignment,\\n24|  type SignupCreditVariant,\\n25|} from \\\"@/lib/signup-credit-experiment-config\\\";\\n26|\\n27|function experimentEnabled(): boolean {\\n28|  return process.env.SIGNUP_CREDITS_EXPERIMENT_ENABLED !== \\\"0\\\";\\n29|}\\n30|\\n31|async function getOrCreateAssignment(userId: string) {\\n32|  const candidate = signupCreditVariantFor(userId);\\n33|  await db\\n34|    .insert(experimentAssignments)\\n35|    .values({\\n36|      userId,\\n37|      experiment: SIGNUP_CREDITS_EXPERIMENT,\\n38|      variant: candidate,\\n39|      eligibility: SIGNUP_CREDITS_ELIGIBILITY,\\n40|    })\\n41|    .onConflictDoNothing({\\n42|      target: [experimentAssignments.userId, experimentAssignments.experiment],\\n43|    });\\n44|\\n45|  const [assignment] = await db\\n46|    .select()\\n47|    .from(experimentAssignments)\\n48|    .where(\\n49|      and(\\n50|        eq(experimentAssignments.userId, userId),\\n51|        eq(experimentAssignments.experiment, SIGNUP_CREDITS_EXPERIMENT),\\n52|      ),\\n53|    )\\n54|    .limit(1);\\n55|  if (!assignment || !isSignupCreditVariant(assignment.variant)) {\\n56|    throw new Error(\\\"signup credit experiment assignment is missing or invalid\\\");\\n5