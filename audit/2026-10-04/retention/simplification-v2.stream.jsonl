{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|/**\\n2| * Credit-economy constants — the pure, client-safe half of the credit system.\\n3| *\\n4| * Split out from lib/credits.ts (which imports the DB) so client components\\n5| * (top-up card, invite card, etc.) can read prices/rewards without pulling\\n6| * server-only code into the browser bundle. lib/credits re-exports everything\\n7| * here, so server code can keep importing from a single place.\\n8| *\\n9| * Tuning the economy is a one-line change in this file.\\n10| */\\n11|\\n12|export const SIGNUP_BONUS = 20;\\n13|/** signup_credits_v1: staged cohort receives this immediately. */\\n14|export const STAGED_SIGNUP_BONUS = 10;\\n15|/** signup_credits_v1: staged cohort receives this on its first 24h+ return. */\\n16|export const STAGED_RETURN_BONUS = 5;\\n17|export const REFERRAL_REWARD = 10;\\n18|/** Free credits granted to every user on the first day of each month. */\\n19|export const MONTHLY_BONUS = 5;\\n20|/** Phone-gift campaign: one-time reward for verifying a mobile number. */\\n21|export const PHONE_VERIFY_GIFT = 10;\\n22|/** …granted on top of the above when promotional-SMS consent first turns on. */\\n23|export const SMS_CONSENT_GIFT = 10;\\n24|\\n25|export {\\n26|  creditPackForCountry,\\n27|  creditPacksForCountry,\\n28|  featuredPremiumPlanForCountry,\\n29|  formatBillingAmount,\\n30|  premiumPlanForCountry,\\n31|  PURCHASE_PROMOTION_CREDIT_THRESHOLD,\\n32|  shouldShowPurchasePromotion,\\n33|  type CreditPack,\\n34|  type PremiumPlan,\\n35|} from \\\"@/lib/billing-config\\\";\\n36|\\n37|/** Credits EARNED by activity (beyond signup/referral/purchase). Capped to\\n38| *  prevent farming — see the caps below. */\\n39|export const CREDIT_REWARD = {\\n40|  /** One small weekly reward keeps the feed loop alive without replacing purchases. */\\n41|  feedPost: 1,\\n42|  profilePhoto: 3,\\n43|} as const;\\n44|\\n45|/** Anti-farming caps for earned credits. */\\n46|export const REWA