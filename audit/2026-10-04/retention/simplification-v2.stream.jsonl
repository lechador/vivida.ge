round:\\n46|            \\\"conic-gradient(from 90deg at 50% 50%, var(--vivida-violet), var(--vivida-pink), var(--vivida-cyan), var(--vivida-violet))\\\",\\n47|        }}\\n48|        animate={{\\n49|          x: parallax.x,\\n50|          y: parallax.y,\\n51|          rotate: [0, 360],\\n52|        }}\\n53|        transition={{\\n54|          x: { duration: 0.8, ease: \\\"easeOut\\\" },\\n55|          y: { duration: 0.8, ease: \\\"easeOut\\\" },\\n56|          rotate: { duration: 90, repeat: Infinity, ease: \\\"linear\\\" },\\n57|        }}\\n58|      />\\n59|\\n60|      {/* Keep the promise and primary action first in the DOM and on mobile.\\n61|          Desktop retains the product preview above the copy via flex order. */}\\n62|      <span\\n63|        className=\\\"order-1 mb-4 inline-flex items-center gap-2 rounded-full border border-border/60 bg-card/50 px-4 py-1.5 text-xs font-medium text-muted-foreground backdrop-blur sm:order-2 sm:mb-5\\\"\\n64|      >\\n65|        <span className=\\\"size-1.5 rounded-full bg-[var(--vivida-cyan)] vivida-pulse\\\" />\\n66|        {c.kicker}\\n67|      </span>\\n68|\\n69|      <h1\\n70|        className=\\\"order-2 text-balance text-4xl font-semibold leading-[1.05] tracking-tight sm:order-3 sm:text-6xl md:text-7xl\\\"\\n71|      >\\n72|        {c.headlinePre}{\\\" \\\"}\\n73|        <span className=\\\"bg-[linear-gradient(120deg,var(--vivida-violet),var(--vivida-pink),var(--vivida-cyan))] bg-clip-text text-transparent\\\">\\n74|          {c.headlineGradient}\\n75|        </span>\\n76|        {c.headlinePost ? (\\n77|          <>\\n78|            <br className=\\\"hidden sm:block\\\" />\\n79|            {\\\" \\\"}\\n80|            {c.headlinePost}\\n81|          </>\\n82|        ) : null}\\n83|      </h1>\\n84|\\n85|      <div className=\\\"order-3 mt-6 sm:order-4 sm:mt-8\\\">\\n86|        <SignInButton label={c.ctaPrimary} loadingLabel={c.ctaPrimaryLoading} />\\n87|      </div>\\n88|\\n89|      <p\\n90|        className=\\\