rtTransition(async () => {\\n50|        const result = await saveProfile(\\n51|          {\\n52|            dateOfBirth: pending.dateOfBirth,\\n53|            timeOfBirth: pending.timeOfBirth,\\n54|            cityName: pending.place.displayName,\\n55|            latitude: pending.place.latitude,\\n56|            longitude: pending.place.longitude,\\n57|            timezone: pending.place.timezone,\\n58|            gender: null,\\n59|          },\\n60|          next,\\n61|          true,\\n62|        );\\n63|        if (result && !result.ok) {\\n64|          setDuplicateAccount(result.code === \\\"duplicate_account\\\");\\n65|          setError(\\n66|            result.code === \\\"possible_duplicate\\\" && en\\n67|              ? \\\"You may already have an account with these birth details. Review this in the next step.\\\"\\n68|              : result.code === \\\"duplicate_account\\\" && en\\n69|                ? \\\"An account with these details already exists. Sign in to your existing account or contact support.\\\"\\n70|                : result.error,\\n71|          );\\n72|        }\\n73|      });\\n74|    });\\n75|    return () => window.cancelAnimationFrame(frame);\\n76|  }, [next, en]);\\n77|\\n78|  if (missing || error) {\\n79|    return (\\n80|      <div className=\\\"w-full max-w-lg rounded-3xl border border-border bg-card/65 p-8 text-center backdrop-blur-xl\\\">\", \"total_lines\": 126, \"file_size\": 4835, \"truncated\": true, \"hint\": \"Use offset=81 to continue reading (showing 1-80 of 126 lines)\", \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 8, "is_error": false, "timestamp": 1791096984424}
