{"type": "tool_result", "name": "terminal", "output": "{\"output\": \"=== push-opt-in ===\\n\\\"use client\\\";\\n\\nimport { useEffect, useRef, useState } from \\\"react\\\";\\nimport { Bell, BellOff, Check, Loader2, X } from \\\"lucide-react\\\";\\n\\nimport { Button } from \\\"@/components/ui/button\\\";\\nimport type { UserLocale } from \\\"@/lib/i18n/user-locale\\\";\\nimport { ANALYTICS_EVENT, trackEvent } from \\\"@/lib/analytics\\\";\\n\\nconst VAPID = process.env.NEXT_PUBLIC_VAPID_PUBLIC_KEY;\\nconst DISMISS_KEY = \\\"vivida_push_prompt_dismissed\\\";\\n\\n/** VAPID public key (base64url) → Uint8Array for pushManager.subscribe. */\\nfunction urlBase64ToUint8Array(base64: string): Uint8Array {\\n  const padding = \\\"=\\\".repeat((4 - (base64.length % 4)) % 4);\\n  const normalized = (base64 + padding).replace(/-/g, \\\"+\\\").replace(/_/g, \\\"/\\\");\\n  const raw = atob(normalized);\\n  const arr = new Uint8Array(raw.length);\\n  for (let i = 0; i < raw.length; i++) arr[i] = raw.charCodeAt(i);\\n  return arr;\\n}\\n\\ntype State =\\n  | \\\"loading\\\"\\n  | \\\"unsupported\\\"\\n  | \\\"unconfigured\\\"\\n  | \\\"denied\\\"\\n  | \\\"off\\\"\\n  | \\\"on\\\"\\n  | \\\"working\\\";\\n\\nconst isIOS =\\n  typeof navigator !== \\\"undefined\\\" &&\\n  /iphone|ipad|ipod/i.test(navigator.userAgent);\\n\\n/**\\n * Web-push opt-in. `card` = a settings block (Account); `banner` = a compact\\n * dismissible dashboard prompt shown only when notifications aren't enabled.\\n */\\nexport function PushOptIn({\\n  variant = \\\"card\\\",\\n  locale = \\\"ka\\\",\\n}: {\\n  variant?: \\\"card\\\" | \\\"banner\\\";\\n  locale?: UserLocale;\\n}) {\\n  const en = locale !== \\\"ka\\\";\\n  const [state, setState] = useState<State>(\\\"loading\\\");\\n  const [error, setError] = useState<string | null>(null);\\n  const [dismissed, setDismissed] = useState(false);\\n  const promptTracked = useRef(false);\\n\\n  useEffect(() => {\\n    let cancelled = false;\\n    (async () => {\\n      try {\\n        if (typeof window !== \\\"undefined\\\") {\\n          setDismissed(localStorage.getItem(DISMISS_KEY) === \\\"1\\\");\\n        }\\n      } catch {\\n        /* ignore */\\n      }\\n      const browserOk =\\n        typeof window !== \\\"undefined\\\" &&\\n        \\\"serviceWorker\\\" in navigator &&\\n        \\\"PushManager\\\" in window &&\\n        \\\"Notification\\\" in window;\\n      if (!browserOk) {\\n        if (!cancelled) setState(\\\"unsupported\\\");\\n        return;\\n      }\\n      // Browser can do push, but our public key isn't in the bundle (env not\\n      // set at build time) — a config/deploy issue, not the user's browser.\\n      if (!VAPID) {\\n        if (!cancelled) setState(\\\"unconfigured\\\");\\n        return;\\n      }\\n      if (Notification.permission === \\\"denied\\\") {\\n        if (!cancelled) setState(\\\"denied\\\");\\n        return;\\n      }\\n      try {\\n        const reg = await navigator.serviceWorker.getRegistration();\\n        const sub = reg ? await reg.pushManager.getSubscription() : null;\\n        if (!cancelled) setState(sub ? \\\"on\\\" : \\\"off\\\");\\n      } catch {\\n        if (!cancelled) setState(\\\"off\\\");\\n      }\\n    })();\\n    return () => {\\n      cancelled = true;\\n    };\\n  }, []);\\n\\n  useEffect(() => {\\n    if (\\n      variant === \\\"banner\\\" &&\\n      state === \\\"off\\\" &&\\n      !dismissed &&\\n      !promptTracked.current\\n    ) {\\n      promptTracked.current = true;\\n      trackEvent(ANALYTICS_EVENT.pushPromptViewed, { surface: variant });\\n    }\\n  }, [dismissed, state, variant]);\\n\\n  async function enable() {\\n    setError(null);\\n    setState(\\\"working\\\");\\n    try {\\n      const perm = await Notification.requestPermission();\\n      if (perm !== \\\"granted\\\") {\\n        if (perm === \\\"denied\\\") {\\n          trackEvent(ANALYTICS_EVENT.pushPermissionDenied, {\\n            surface: variant,\\n          });