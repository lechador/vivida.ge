{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|export type StreakInfo = {\\n2|  current: number;\\n3|  longest: number;\\n4|  todayComplete: boolean;\\n5|};\\n6|\\n7|export function shiftDate(date: string, delta: number): string {\\n8|  const [year, month, day] = date.split(\\\"-\\\").map(Number);\\n9|  return new Date(Date.UTC(year, month - 1, day) + delta * 86_400_000)\\n10|    .toISOString()\\n11|    .slice(0, 10);\\n12|}\\n13|\\n14|export function calculateStreak(\\n15|  completedDates: Iterable<string>,\\n16|  today: string,\\n17|): StreakInfo {\\n18|  const days = new Set(completedDates);\\n19|  const todayComplete = days.has(today);\\n20|  const start = todayComplete ? today : shiftDate(today, -1);\\n21|\\n22|  let current = 0;\\n23|  for (let cursor = start; days.has(cursor); cursor = shiftDate(cursor, -1)) current += 1;\\n24|\\n25|  let longest = 0;\\n26|  let run = 0;\\n27|  let previous: string | null = null;\\n28|  for (const day of [...days].sort()) {\\n29|    run = previous !== null && shiftDate(previous, 1) === day ? run + 1 : 1;\\n30|    longest = Math.max(longest, run);\\n31|    previous = day;\\n32|  }\\n33|  return { current, longest, todayComplete };\\n34|}\", \"total_lines\": 34, \"file_size\": 986, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 8, "is_error": false, "timestamp": 1791096955135}
