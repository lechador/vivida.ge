{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|import { and, eq, isNotNull, sql } from \\\"drizzle-orm\\\";\\n2|\\n3|import { db } from \\\"@/db\\\";\\n4|import { profiles, userActivityDays } from \\\"@/db/schema\\\";\\n5|import { formatLocalDate } from \\\"@/lib/activity\\\";\\n6|import { calculateStreak } from \\\"@/lib/streak\\\";\\n7|import { awardRitualMilestone, toStreakProgress, type StreakProgress } from \\\"@/lib/streak-credits\\\";\\n8|\\n9|export const DAILY_RITUAL_VERSION = 2;\\n10|\\n11|async function ritualContext(userId: string) {\\n12|  const [profile] = await db\\n13|    .select({ timezone: profiles.timezone })\\n14|    .from(profiles)\\n15|    .where(eq(profiles.userId, userId))\\n16|    .limit(1);\\n17|  const timezone = profile?.timezone ?? \\\"UTC\\\";\\n18|  return { timezone, today: formatLocalDate(new Date(), timezone) };\\n19|}\\n20|\\n21|export async function getDailyRitualProgress(userId: string): Promise<StreakProgress> {\\n22|  const { today } = await ritualContext(userId);\\n23|  const rows = await db\\n24|    .select({ date: userActivityDays.dateLocal })\\n25|    .from(userActivityDays)\\n26|    .where(\\n27|      and(\\n28|        eq(userActivityDays.userId, userId),\\n29|        eq(userActivityDays.ritualVersion, DAILY_RITUAL_VERSION),\\n30|        isNotNull(userActivityDays.ritualCompletedAt),\\n31|      ),\\n32|    );\\n33|  return toStreakProgress(calculateStreak(rows.map((row) => row.date), today));\\n34|}\\n35|\\n36|export async function completeDailyRitualFor(userId: string): Promise<{\\n37|  ok: true;\\n38|  firstCompletion: boolean;\\n39|  awardedCredits: number;\\n40|  progress: StreakProgress;\\n41|}> {\\n42|  const { today } = await ritualContext(userId);\\n43|  const completedAt = new Date();\\n44|\\n45|  const result = await db.execute<{ first_completion: boolean }>(sql`\\n46|    INSERT INTO user_activity_day (user_id, date_local, ritual_completed_at, ritual_version)\\n47|    VALUES (${userId}, ${today}, ${completedAt}, ${DAILY_RITUAL_VERSION})\\n48|    ON CONFLICT (user_id, date_local) DO UPDATE\\n49|    SET ritual_completed_at = EXCLUDED.ritual_completed_at,\\n50|        ritual_version = EXCLUDED.ritual_version\\n51|    WHERE user_activity_day.ritual_version IS DISTINCT FROM ${DAILY_RITUAL_VERSION}\\n52|       OR user_activity_day.ritual_completed_at IS NULL\\n53|    RETURNING true AS first_completion\\n54|  `);\\n55|  const firstCompletion = result.rows.length > 0;\\n56|  const progress = await getDailyRitualProgress(userId);\\n57|  // Also run on an idempotent retry, repairing a transient reward failure.\\n58|  const awardedCredits = await awardRitualMilestone(userId, progress.current);\\n59|  return { ok: true, firstCompletion, awardedCredits, progress };\\n60|}\", \"total_lines\": 60, \"file_size\": 2386, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 3, "is_error": false, "timestamp": 1791096933418}
{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|export type DailyRitualState = { horoscopeRead: boolean; focus: string | null };\\n2|\\n3|const EMPTY: DailyRitualState = { horoscopeRead: false, focus: null };\\n4|const PREFIX = \\\"vivida_daily_ritual_v2\\\";\\n5|\\n6|function key(userId: string, date: string): string {\\n7|  return `${PREFIX}:${encodeURIComponent(userId)}:${date}`;\\n8|}\\n9|\\n10|export function readDailyRitual(userId: string, date: string): DailyRitualState {\\n11|  if (typeof window === \\\"undefined\\\") return { ...EMPTY };\\n12|  try {\\n13|    const value = JSON.parse(localStorage.getItem(key(userId, date)) ?? \\\"null\\\") as unknown;\\n14|    if (!value || typeof value !== \\\"object\\\") return { ...EMPTY };\\n15|    const record = value as Record<string, unknown>;\\n16|    return {\\n17|      horoscopeRead: record.horoscopeRead === true,\\n18|      focus: typeof record.focus === \\\"string\\\" && record.focus.length <= 80 ? record.focus : null,\\n19|    };\\n20|  } catch {\\n21|    return { ...EMPTY };\\n22|  }\\n23|}\\n24|\\n25|export function saveDailyRitual(userId: string, date: string, state: DailyRitualState): void {\\n26|  if (typeof window === \\\"undefined\\\") return;\\n27|  try {\\n28|    localStorage.setItem(key(userId, date), JSON.stringify(state));\\n29|  } catch {\\n30|    // Private browsing/storage quotas must never block completion.\\n31|  }\\n32|}\", \"total_lines\": 32, \"file_size\": 1186, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 3, "is_error": false, "timestamp": 1791096933435}
