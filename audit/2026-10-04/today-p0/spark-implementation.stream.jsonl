rue })).toBe(false);\\n54|  });\\n55|\\n56|  it(\\\"stays hidden after dismissal — the popup is strictly one-time\\\", () => {\\n57|    expect(phoneGiftPopupEligible({ ...viewer, popupDismissed: true })).toBe(\\n58|      false,\\n59|    );\\n60|  });\\n61|});\\n62|\\n63|describe(\\\"phoneGiftCardEligible\\\", () => {\\n64|  it(\\\"survives the popup dismissal — the offer stays on the credits page\\\", () => {\\n65|    expect(\\n66|      phoneGiftCardEligible({\\n67|        hasVerifiedPhone: false,\\n68|        isPremium: false,\\n69|        restricted: false,\\n70|      }),\\n71|    ).toBe(true);\\n72|  });\\n73|\\n74|  it(\\\"hides once a number is verified\\\", () => {\\n75|    expect(\\n76|      phoneGiftCardEligible({\\n77|        hasVerifiedPhone: true,\\n78|        isPremium: false,\\n79|        restricted: false,\\n80|      }),\\n81|    ).toBe(false);\\n82|  });\\n83|\\n84|  it(\\\"hides for PRO and restricted accounts, same as the popup\\\", () => {\\n85|    expect(\\n86|      phoneGiftCardEligible({\\n87|        hasVerifiedPhone: false,\\n88|        isPremium: true,\\n89|        restricted: false,\\n90|      }),\\n91|    ).toBe(false);\\n92|    expect(\\n93|      phoneGiftCardEligible({\\n94|        hasVerifiedPhone: false,\\n95|        isPremium: false,\\n96|        restricted: true,\\n97|      }),\\n98|    ).toBe(false);\\n99|  });\\n100|});\", \"total_lines\": 100, \"file_size\": 2723, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 5, "is_error": false, "timestamp": 1791119457322}
