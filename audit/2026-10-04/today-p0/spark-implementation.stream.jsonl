{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|\\\"use client\\\";\\n2|\\n3|import { useEffect, useState } from \\\"react\\\";\\n4|\\n5|import type {\\n6|  ChatClearedDetail,\\n7|  ChatNotifyDetail,\\n8|} from \\\"@/components/chat/chat-launcher\\\";\\n9|import type { UserLocale } from \\\"@/lib/i18n/user-locale\\\";\\n10|\\n11|/**\\n12| * Tiny live counter for the bottom-bar messages tab. Seeded from the\\n13| * server-side unread total, then kept in sync via the same custom events\\n14| * the bell dropdown listens for:\\n15| *\\n16| *   - vivida:chat-message → +1 (only fires when not actively viewing)\\n17| *   - vivida:chat-cleared → -clearedCount when a conversation is opened\\n18| *\\n19| * The badge component never queries the DB itself — the SSE pump (modal\\n20| * launcher in background mode, or the /messages page) is the source of\\n21| * truth for \\\"what's new\\\".\\n22| */\\n23|export function MessagesTabBadge({\\n24|  initial,\\n25|  locale = \\\"ka\\\",\\n26|}: {\\n27|  initial: number;\\n28|  locale?: UserLocale;\\n29|}) {\\n30|  const [badge, setBadge] = useState({ initial, count: initial });\\n31|\\n32|  if (badge.initial !== initial) {\\n33|    setBadge({ initial, count: initial });\\n34|  }\\n35|\\n36|  const count = badge.count;\\n37|\\n38|  useEffect(() => {\\n39|    const onMsg = (e: Event) => {\\n40|      const detail = (e as CustomEvent<ChatNotifyDetail>).detail;\\n41|      if (!detail?.id) return;\\n42|      setBadge((current) => ({\\n43|        ...current,\\n44|        count: current.count + 1,\\n45|      }));\\n46|    };\\n47|    const onCleared = (e: Event) => {\\n48|      const detail = (e as CustomEvent<ChatClearedDetail>).detail;\\n49|      if (!detail) return;\\n50|      const drop = Math.max(0, detail.clearedCount ?? 0);\\n51|      if (drop === 0) return;\\n52|      setBadge((current) => ({\\n53|        ...current,\\n54|        count: Math.max(0, current.count - drop),\\n55|      }));\\n56|    };\\n57|    window.addEventListener(\\\"vivida:chat-message\\\", onMsg);\\n58|    window.addEventListener(\\\"vivida:chat-cleared\\\", onCleared);\\n59|    return () => {\\n60|      window.removeEventListener(\\\"vivida:chat-message\\\", onMsg);\\n61|      window.removeEventListener(\\\"vivida:chat-cleared\\\", onCleared);\\n62|    };\\n63|  }, []);\\n64|\\n65|  if (count <= 0) return null;\\n66|  return (\\n67|    <span\\n68|      aria-label={\\n69|        locale !== \\\"ka\\\"\\n70|          ? `${count} new ${count === 1 ? \\\"message\\\" : \\\"messages\\\"}`\\n71|          : `${count} ახალი წერილი`\\n72|      }\\n73|      className=\\\"absolute -right-0.5 -top-0.5 grid size-4 min-w-4 place-items-center rounded-full bg-[var(--vivida-pink)] px-1 text-[9px] font-semibold leading-none text-white ring-2 ring-background\\\"\\n74|    >\\n75|      {count > 9 ? \\\"9+\\\" : count}\\n76|    </span>\\n77|  );\\n78|}\", \"total_lines\": 78, \"file_size\": 2397, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 11, "is_error": false, "timestamp": 1791119426843}
