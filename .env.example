# ──────────────────────────────────────────────────────────────
# Vivida — required environment variables
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────

# Auth.js v5
# Generate with: npx auth secret
AUTH_SECRET=
# Local development URL only. Leave AUTH_URL unset in Vercel production so
# Auth.js derives the active vivida.ge/vividaastro.com host per request.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth credentials
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://www.vivida.ge/api/auth/callback/google
#   https://www.vividaastro.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (web)
# AUTH_APPLE_ID is the Apple Services ID, not the native iOS bundle ID.
# AUTH_APPLE_SECRET is Apple's signed client-secret JWT (maximum lifetime: 6 months).
# Renew it with scripts/generate-apple-client-secret.mjs before expiry.
# Configure these return URLs on the Services ID:
#   https://www.vivida.ge/api/auth/callback/apple
#   https://www.vividaastro.com/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Neon Postgres connection string
# https://console.neon.tech/  →  Connection string (pooled)
DATABASE_URL=

# freeastrologyapi.com
# https://freeastrologyapi.com/  →  Dashboard
# Optional. By default we use the local Swiss-Ephemeris-based engine.
# Set FREE_ASTROLOGY_API_AS_PRIMARY=true to call the remote API first
# (only useful when you need an endpoint we don't compute locally yet,
# e.g. their hosted SVG wheel).
FREE_ASTROLOGY_API_KEY=
FREE_ASTROLOGY_API_AS_PRIMARY=

# OpenRouter — used for Gemini 2.5 Pro interpretations
OPENROUTER_API_KEY=

# Cloudflare R2 — profile photos
# Dashboard: https://dash.cloudflare.com/  →  R2  →  your bucket
# Public URL: bucket Settings → R2.dev subdomain (or a custom domain in prod)
# Token:     R2 → Manage API Tokens → Object Read & Write on this bucket
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# The quiz asset seed endpoint uses the R2 variables above. No additional
# credential is needed: it is protected by the existing ADMIN_EMAILS session.

# Resend — transactional email (verification + password reset)
# https://resend.com/api-keys
RESEND_API_KEY=
# `from` address — must be a verified domain in production.
# In dev, Resend's sandbox accepts `onboarding@resend.dev`.
RESEND_FROM=Vivida <onboarding@resend.dev>
# Default origin for background/mobile emails. Web auth emails use the
# recognized request host, so vividaastro.com signups keep .com links.
APP_ORIGIN=http://localhost:3000

# Cloudflare Turnstile — bot prevention on signup/login/forgot-password
# https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (embedded in the page). Secret key is server-only.
# Allow both www.vivida.ge and www.vividaastro.com on the Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX format).
# Loaded in production or the explicit local debug mode below. Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Local DebugView only: set to 1 in an isolated non-Vercel local build. The
# browser must also use localhost, 127.0.0.1, or [::1]; never set in Vercel.
GA_DEBUG_MODE=

# Meta / Facebook Pixel — Dataset ID from business.facebook.com.
# Loaded only in production. Leave blank to disable.
NEXT_PUBLIC_FB_PIXEL_ID=
META_DATASET_ID=
META_CONVERSIONS_API_TOKEN=
META_GRAPH_API_VERSION=v24.0
# Temporary only while validating events in Meta Events Manager.
META_TEST_EVENT_CODE=

# Sentry — production error monitoring. Leave the DSN blank to disable the SDK.
# The public DSN is safe to expose; the auth token is server/build-only and must
# be stored as a protected Vercel environment variable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Fraction of performance traces to retain (0–1). Errors are always captured.
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Shared secret for the vivida_admin → vivida.ge bulk-email API.
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Set the same value in vivida_admin/.env.local.
ADMIN_API_TOKEN=

# Comma-separated allow-list for /admin/* pages (case-insensitive).
# Falls back to the founder email in dev; set explicitly in production.
ADMIN_EMAILS=

# Bearer secret for Vercel Cron → /api/cron/daily-horoscope.
# Vercel sends this in the Authorization header on each scheduled
# invocation. Generate with the same crypto.randomBytes recipe above.
# Set in Vercel project env vars; not needed for local dev.
CRON_SECRET=

# ── OneSignal native push (Flutter iOS + Android) ───────────────────────────
# App ID is public and is also passed to Flutter as ONESIGNAL_APP_ID.
# The API key is server-only; never include it in a mobile build.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── Stripe — reports, credit top-ups, and PRO subscriptions ────────────
# Secret key from Stripe → Developers → API keys (sk_test_… or sk_live_…).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). Shown when you add the endpoint
#   https://vivida.ge/api/stripe/webhook
# in Stripe → Developers → Webhooks, subscribed to:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# ── RevenueCat (in-app purchases) ────────────────────────────────────────────
# Shared secret for POST /api/revenuecat/webhook. RevenueCat cannot sign
# requests the way Stripe does, so this string is sent verbatim in the
# Authorization header and must match the value in the RevenueCat dashboard
# (Project → Integrations → Webhooks → Authorization header).
#
# The route REFUSES every request while this is unset — an open endpoint here
# would write PRO entitlements and mint credits. Generate with:
#   openssl rand -base64 32
REVENUECAT_WEBHOOK_AUTH=
# Price + currency for the natal report. Stripe may not support charging in
# GEL depending on your account/entity — if checkout errors on currency,
# switch to a supported one (e.g. usd) and set the matching amount.
#   1990 = ₾19.90 (amount is in the currency's minor unit / tetri / cents)
REPORT_PRICE_CENTS=1990
REPORT_CURRENCY=gel
# Optional but strongly recommended for static/ISR deployments. Set `ka` on a
# Georgian-only Vercel project. `en` and `am` are also supported when those URL
# spaces are deployed independently (for example behind a path-aware edge
# proxy). Omit it on a project that still serves multiple locale spaces.
VIVIDA_DEPLOYMENT_LOCALE=

# ── Web Push (browser notifications) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Public key is embedded in the client; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to push services (mailto: or https:).
VAPID_SUBJECT=mailto:hello@vivida.ge

# ── Social feature flags (all ship OFF at low density) ───────────────────
# Set to "1" or "true" per environment to enable. NEXT_PUBLIC_* so server
# route guards and client nav see the same value.
NEXT_PUBLIC_SOCIAL_SWIPE_DECK=
NEXT_PUBLIC_SOCIAL_PEOPLE_DIRECTORY=
NEXT_PUBLIC_SOCIAL_SUGGESTED_PEOPLE=

# ── Mobile API (Flutter iOS + Android) ───────────────────────────────────
# Short-lived access-token signing secret. Falls back to AUTH_SECRET when
# unset, but set explicitly in production so web/mobile keys rotate
# independently.
MOBILE_JWT_SECRET=
# Extra OAuth client IDs accepted by /api/v1/auth/google and
# /api/v1/auth/apple (comma-separated). Web IDs come from
# GOOGLE_CLIENT_ID / AUTH_APPLE_ID; list native bundle IDs / iOS Services
# IDs here.
GOOGLE_MOBILE_CLIENT_IDS=
APPLE_MOBILE_CLIENT_IDS=

# ── Background/marketing email origin ────────────────────────────────────
# Base URL for links in cron/marketing emails (no request host available).
EMAIL_ORIGIN=https://vivida.ge

# ── AI overrides ─────────────────────────────────────────────────────────
# Direct Gemini key (optional). When unset, synthesis uses OPENROUTER_API_KEY.
# GOOGLE_CLOUD_PROJECT enables Vertex AI fallback instead.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Model override for paid report generation (default: google/gemini-3.8-flash).
OPENROUTER_REPORT_MODEL=

# ── Experiments ──────────────────────────────────────────────────────────
# Signup-credit cohort test kill switch. Set to "0" to pause new assignments
# (legacy balances untouched); any other value / unset keeps the 50/50 test.
SIGNUP_CREDITS_EXPERIMENT_ENABLED=1

# ── Tests only (never production) ────────────────────────────────────────
# Real Postgres used by *.integration.test.ts. CI sets both to the same
# postgres:17 service; locally point at a scratch database, never prod.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vivida_test
