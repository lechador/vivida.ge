# ──────────────────────────────────────────────────────────────
# Vivida — required environment variables
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────

# Auth.js v5
# Generate with: npx auth secret
AUTH_SECRET=
# Local development URL only. Leave AUTH_URL unset in Vercel production so
# Auth.js derives the active vivida.ge/vividaastro.com host per request.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth credentials
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://www.vivida.ge/api/auth/callback/google
#   https://www.vividaastro.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon Postgres connection string
# https://console.neon.tech/  →  Connection string (pooled)
DATABASE_URL=

# freeastrologyapi.com
# https://freeastrologyapi.com/  →  Dashboard
# Optional. By default we use the local Swiss-Ephemeris-based engine.
# Set FREE_ASTROLOGY_API_AS_PRIMARY=true to call the remote API first
# (only useful when you need an endpoint we don't compute locally yet,
# e.g. their hosted SVG wheel).
FREE_ASTROLOGY_API_KEY=
FREE_ASTROLOGY_API_AS_PRIMARY=

# OpenRouter — used for Gemini 2.5 Pro interpretations
OPENROUTER_API_KEY=

# Cloudflare R2 — profile photos
# Dashboard: https://dash.cloudflare.com/  →  R2  →  your bucket
# Public URL: bucket Settings → R2.dev subdomain (or a custom domain in prod)
# Token:     R2 → Manage API Tokens → Object Read & Write on this bucket
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# The quiz asset seed endpoint uses the R2 variables above. No additional
# credential is needed: it is protected by the existing ADMIN_EMAILS session.

# Resend — transactional email (verification + password reset)
# https://resend.com/api-keys
RESEND_API_KEY=
# `from` address — must be a verified domain in production.
# In dev, Resend's sandbox accepts `onboarding@resend.dev`.
RESEND_FROM=Vivida <onboarding@resend.dev>
# Default origin for background/mobile emails. Web auth emails use the
# recognized request host, so vividaastro.com signups keep .com links.
APP_ORIGIN=http://localhost:3000

# Cloudflare Turnstile — bot prevention on signup/login/forgot-password
# https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (embedded in the page). Secret key is server-only.
# Allow both www.vivida.ge and www.vividaastro.com on the Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX format).
# Loaded only in production (see app/layout.tsx). Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# eve weekly SEO/product audit (Monday, 10:00 Asia/Tbilisi)
# A dedicated Google service-account JSON string. Grant its client_email Viewer
# access in GA4 and read access in both Search Console properties.
GOOGLE_SEO_SERVICE_ACCOUNT_JSON=
# Numeric GA4 property id (not the G- measurement id).
GA4_PROPERTY_ID=535821581
# Comma-separated Search Console property identifiers.
GSC_SITE_URLS=sc-domain:vivida.ge,sc-domain:vividaastro.com
# Report delivery: webhook wins; otherwise email; otherwise Vercel Logs.
SEO_AUDIT_WEBHOOK_URL=
SEO_AUDIT_WEBHOOK_BEARER=
SEO_AUDIT_RECIPIENT_EMAIL=

# Meta / Facebook Pixel — Dataset ID from business.facebook.com.
# Loaded only in production. Leave blank to disable.
NEXT_PUBLIC_FB_PIXEL_ID=

# Sentry — production error monitoring. Leave the DSN blank to disable the SDK.
# The public DSN is safe to expose; the auth token is server/build-only and must
# be stored as a protected Vercel environment variable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Fraction of performance traces to retain (0–1). Errors are always captured.
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Shared secret for the vivida_admin → vivida.ge bulk-email API.
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Set the same value in vivida_admin/.env.local.
ADMIN_API_TOKEN=

# Bearer secret for Vercel Cron → /api/cron/daily-horoscope.
# Vercel sends this in the Authorization header on each scheduled
# invocation. Generate with the same crypto.randomBytes recipe above.
# Set in Vercel project env vars; not needed for local dev.
CRON_SECRET=

# ── Stripe — reports, credit top-ups, and PRO subscriptions ────────────
# Secret key from Stripe → Developers → API keys (sk_test_… or sk_live_…).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). Shown when you add the endpoint
#   https://vivida.ge/api/stripe/webhook
# in Stripe → Developers → Webhooks, subscribed to:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Price + currency for the natal report. Stripe may not support charging in
# GEL depending on your account/entity — if checkout errors on currency,
# switch to a supported one (e.g. usd) and set the matching amount.
#   1990 = ₾19.90 (amount is in the currency's minor unit / tetri / cents)
REPORT_PRICE_CENTS=1990
REPORT_CURRENCY=gel
